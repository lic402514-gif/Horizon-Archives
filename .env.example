# ── 必需修改 ──────────────────────────────────────────────
SITE_URL=https://your-domain.com          # 你的域名，用于 sitemap/RSS
SECRET_KEY=replace-with-random-64-char    # JWT 签名密钥
ADMIN_PASSWORD=your-strong-password       # 管理员初始密码

# ── 数据库（SQLite 默认即可，换 PostgreSQL 时改下面） ──
# DATABASE_URL=sqlite:///./data/library.db
# DATABASE_URL=postgresql://user:pass@db:5432/library

# ── OSS 配置（生产环境必填，本地开发用本地存储） ─────────
# OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-key
# OSS_ACCESS_KEY_SECRET=your-secret
# OSS_BUCKET_NAME=your-bucket
